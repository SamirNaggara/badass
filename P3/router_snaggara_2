# ==========================================
# DATA PLANE (Configuration Linux)
# ==========================================

# Creation du switch virtuel (bridge)
ip link add br0 type bridge
ip link set br0 up

# Creation du tunnel VXLAN (VNI 10)
# Note : Pas de remote ni de group, BGP decouvre les pairs automatiquement
ip link add vxlan10 type vxlan id 10 local 1.1.1.2 dstport 4789
ip link set vxlan10 master br0
ip link set vxlan10 up

# Connexion de l hote au bridge
ip link set eth1 up
ip link set eth1 master br0

# ==========================================
# CONTROL PLANE (Configuration FRRouting)
# ==========================================
vtysh -c 'configure terminal
! --- UNDERLAY (OSPF) ---
! Identite du routeur
interface lo
 ip address 1.1.1.2/32
exit

! Lien physique vers le Spine (Route Reflector)
interface eth0
 ip address 10.1.1.2/30
 ip ospf network point-to-point
exit

! Annonce OSPF pour joindre les autres routeurs
router ospf
 network 1.1.1.2/32 area 0
 network 10.1.1.0/30 area 0
exit

! --- OVERLAY (BGP EVPN) ---
router bgp 1
 bgp router-id 1.1.1.2
 
 ! Connexion au Route Reflector via la Loopback
 neighbor 1.1.1.1 remote-as 1
 neighbor 1.1.1.1 update-source lo
 
 ! Activation EVPN pour diffuser nos adresses MAC
 address-family l2vpn evpn
  neighbor 1.1.1.1 activate
  ! Annonce automatique de notre VXLAN local a tout le reseau
  advertise-all-vni
 exit-address-family
exit
end
write memory'